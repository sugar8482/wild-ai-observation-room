# Optional. The app creates .env.local with random values on first launch.
PORT=4173
HOST=0.0.0.0
OBSERVATION_ACCESS_CODE=replace-with-your-own-8-character-code
OBSERVATION_ACCESS_REQUIRED=true
OBSERVATION_FORCE_ACCESS_CODE=false
OBSERVATION_SESSION_TOKEN=replace-with-a-long-random-session-token
OBSERVATION_DATA_KEY=replace-with-a-long-random-secret

# Optional hosted primary database. Leave blank to use the bundled zero-config
# SQLite database at data/observation-room.sqlite. JSON remains a disaster-
# recovery mirror in both modes.
OBSERVATION_DATABASE_URL=
OBSERVATION_DATABASE_SSL=false
